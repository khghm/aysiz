# پیکربندی سرور بک‌اند فروشگاه تای سیز
# کپی کنید به .env و مقادیر را تنظیم کنید

PORT=4000
POSTGRES_DB=tasis
POSTGRES_USER=tasis
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql://tasis:change-me-local@localhost:5432/tasis
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_SSL=false
DATABASE_SSL_VERIFY=true
# محدوده proxy مورد اعتماد؛ برای Nginx محلی loopback مناسب است.
TRUST_PROXY=loopback
JWT_SECRET=tasis-dev-secret-change-me
JWT_EXPIRES_IN=30d
FRONTEND_URL=http://localhost:3000
SERVER_URL=http://localhost:4000
# originهای اضافی مجاز CORS با comma جدا شوند؛ FRONTEND_URL خودکار مجاز است.
CORS_ORIGINS=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=مدیر کل

# زرین‌پال — برای فعال‌سازی درگاه واقعی فقط ZARINPAL_MERCHANT_ID را با مرچنت آی‌دی دریافتی پر کنید
ZARINPAL_MERCHANT_ID=TEST-MERCHANT-ID-REPLACE-ME
ZARINPAL_MODE=mock
ZARINPAL_SANDBOX=false
ZARINPAL_DESCRIPTION=پرداخت سفارش فروشگاه تای سیز
ZARINPAL_CURRENCY=IRR

# کاوه‌نگار — برای ارسال پیامک واقعی فقط KAVENEGAR_API_KEY را پر کنید
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=tasis-otp
KAVENEGAR_SENDER=

OTP_EXPIRY_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
OTP_DEV_FIXED_CODE=
OTP_RETURN_IN_RESPONSE=true
